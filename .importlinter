[importlinter]
root_package = rig
include_external_packages = False

# ── 1. Camadas: só desce. Ver docs/10-engineering-standards.md §1 ──
[importlinter:contract:layers]
name = Camadas so descem: eval -> api -> agents -> dominio -> core
type = layers
layers =
    rig.eval
    rig.api
    rig.agents
    rig.ingestion | rig.retrieval | rig.audit | rig.integrations
    rig.core

# ── 2. Produção nunca depende do harness de avaliação ──
[importlinter:contract:no-eval-in-prod]
name = Producao nao importa rig.eval
type = forbidden
source_modules =
    rig.api
    rig.agents
    rig.ingestion
    rig.retrieval
    rig.audit
    rig.integrations
    rig.core
forbidden_modules =
    rig.eval

# ── 3. Agente não busca dado: ingestão é plano offline ──
[importlinter:contract:agents-no-ingestion]
name = rig.agents nao importa rig.ingestion
type = forbidden
source_modules =
    rig.agents
forbidden_modules =
    rig.ingestion

# ── 4. O domínio não conhece transporte: nada em audit/retrieval importa integrations ──
[importlinter:contract:domain-ignores-transport]
name = Dominio e retrieval nao importam integrations
type = forbidden
source_modules =
    rig.audit
    rig.retrieval
forbidden_modules =
    rig.integrations

# ── 5. rig.graph é camada de orquestração: importa adapters/retrieval/audit/core ──
[importlinter:contract:graph-boundaries]
name = rig.graph nao importa api, eval, ingestion, agents nem integrations
type = forbidden
source_modules =
    rig.graph
forbidden_modules =
    rig.api
    rig.eval
    rig.ingestion
    rig.agents
    rig.integrations

# ── 6. rig.adapters é folha: só rig.core (e libs externas) ──
[importlinter:contract:adapters-leaf]
name = rig.adapters so importa rig.core
type = forbidden
source_modules =
    rig.adapters
forbidden_modules =
    rig.api
    rig.eval
    rig.agents
    rig.graph
    rig.ingestion
    rig.retrieval
    rig.audit
    rig.integrations

# ── 7. Camadas do grafo: graph -> (adapters | retrieval | audit) -> core ──
[importlinter:contract:graph-layers]
name = Camadas do grafo: graph -> adapters/retrieval/audit -> core
type = layers
layers =
    rig.graph
    rig.adapters | rig.retrieval | rig.audit
    rig.core
