# ── LLM ────────────────────────────────────────────────
DEEPSEEK_API_KEY=***
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
MODEL_TRIAGE=deepseek-flash
MODEL_AUDIT=deepseek-flash
MODEL_DRAFT=deepseek-flash
MODEL_EMBEDDING=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── Banco ──────────────────────────────────────────────
DATABASE_URL=postgresql://rig:rig@localhost:5432/rig
REDIS_URL=redis://localhost:6379/0

# ── Ingestão ───────────────────────────────────────────
CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2
CAMARA_USER_AGENT=rig-intelligence-engine/0.1 (portfolio; contato no README)
CAMARA_RPS=1
INGEST_ANOS=2023,2024,2025,2026
INGEST_TIPOS=PL,PLP,PEC,MPV,PDL
DATA_DIR=./data

# ── Slack (HITL) ───────────────────────────────────────
SLACK_BOT_TOKEN=SLACK_...RET=
SLACK_CHANNEL_ID=
SLACK_REVIEWER_IDS=

# ── Orçamento e limites ────────────────────────────────
MAX_COST_USD_PER_RUN=0.20
MAX_DEADLINE_S=90
MAX_REPAIR_CYCLES=2
RETRIEVAL_MIN_CONFIDENCE=0.35

# ── Observabilidade (opcional) ─────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=***
